# name: test/sql/serialization.test
# description: compiled tree arguments survive binary serialization and SQL export
# group: [sql]

require apart

statement ok
SET debug_verify_serializer = true;

statement ok
SET debug_verify_statement = 'explain_sql_strict';

# The tree lives in bind data; only features remain as executable arguments.
# Exercise the one-argument serialized signature and both evaluator families.
foreach dimensions 1 3 8

statement ok
CREATE OR REPLACE MACRO serialization_tree() AS {
    weights: [list_transform(range({dimensions}), lambda i: 1)],
    thresholds: [0], children: [[-2, -1]], values: ['below', 'above']
};

query I
SELECT count(*)
FROM range(-4096, 4096) inputs(i)
WHERE decision_tree(serialization_tree(),
    list_transform(range({dimensions}), lambda j: i)::DOUBLE[{dimensions}])
    IS DISTINCT FROM CASE WHEN i >= 0 THEN 'above' ELSE 'below' END;
----
0

endloop

statement ok
CREATE MACRO serialization_scalar_tree() AS {
    weights: [[1]], thresholds: [0], children: [[-2, -1]], values: [NULL::INTEGER, 42]
};

# Execution must receive only features. Retaining the nested constant tree here
# would reconstruct it for every batch despite returning the correct results.
foreach feature i::DOUBLE [i]::DOUBLE[1]

statement ok
CREATE OR REPLACE TABLE runtime_features AS SELECT {feature} AS x FROM range(10) inputs(i);

query II
EXPLAIN (FORMAT JSON) SELECT decision_tree(serialization_scalar_tree(), x) FROM runtime_features;
----
physical_plan	<REGEX>:(?s).*"Projections": "decision_tree\(x\)".*

endloop

query I
SELECT count(*) FROM range(-4096, 4096) inputs(i)
WHERE decision_tree(serialization_scalar_tree(), i)
    IS DISTINCT FROM CASE WHEN i >= 0 THEN 42 ELSE NULL END;
----
0

query I
SELECT count(*) FROM range(-4096, 4096) inputs(i)
WHERE decision_tree({weights: [[1, 0]], thresholds: [0], children: [[-2, -1]], values: [10, 20]},
    i, 1.0::FLOAT) IS DISTINCT FROM CASE WHEN i >= 0 THEN 20 ELSE 10 END;
----
0

# Rebinding a prepared tree must not retain state from a previous invocation.
statement ok
PREPARE serialized_tree_parameter AS SELECT sum(decision_tree($1, i)) FROM range(-10, 10) inputs(i);

query I
EXECUTE serialized_tree_parameter(serialization_scalar_tree());
----
420

query I
EXECUTE serialized_tree_parameter(struct_update(serialization_scalar_tree(), "values" := [7, 9]));
----
160

query I
EXECUTE serialized_tree_parameter(NULL);
----
NULL

query I
EXECUTE serialized_tree_parameter(serialization_scalar_tree());
----
420

# The permissive catalog signature must still reject feature-only SQL calls.
statement error
SELECT decision_tree(serialization_scalar_tree());
----
decision_tree requires a tree followed by at least one feature input

statement error
SELECT decision_tree(1);
----
decision_tree requires a tree followed by at least one feature input
