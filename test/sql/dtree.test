# name: test/sql/dtree.test
# description: decision_tree scalar function
# group: [sql]

require dtree

# score = x0; negative values return 10. Non-negative values continue to
# score = x1, which returns 20 below 10 and 30 at or above 10.
query I
SELECT decision_tree(
    {
        weights: [1, 0],
        threshold: 0,
        below: {value: 10},
        above: {
            weights: [0, 1],
            threshold: 10,
            below: {value: 20},
            above: {value: 30}
        }
    },
    x,
    y
)
FROM (VALUES (-1.0::FLOAT, 100.0::FLOAT), (1.0::FLOAT, 5.0::FLOAT), (1.0::FLOAT, 10.0::FLOAT))
    features(x, y);
----
10
20
30

# The affine predicate is score >= threshold; NaN makes it false.
query I
SELECT decision_tree(
    {
        weights: [1],
        threshold: 0,
        below: {value: 10},
        above: {value: 20}
    },
    'NaN'::FLOAT
);
----
10

query I
SELECT decision_tree(
    {
        weights: [1, 0],
        threshold: 0,
        below: {value: 10},
        above: {
            weights: [0, 1],
            threshold: 10,
            below: {value: 20},
            above: {value: 30}
        }
    },
    [x, y]::FLOAT[2]
)
FROM (VALUES (-1.0::FLOAT, 100.0::FLOAT), (1.0::FLOAT, 5.0::FLOAT), (1.0::FLOAT, 10.0::FLOAT))
    features(x, y);
----
10
20
30

# Both overloads handle DuckDB's non-flat and nullable vector representations.
statement ok
CREATE MACRO generic_test_tree() AS {
    weights: [1, 0, 0],
    threshold: 0,
    below: {value: 10},
    above: {
        weights: [0, 1, 0],
        threshold: 0,
        below: {value: 20},
        above: {value: 30}
    }
};

query T
SELECT DISTINCT vector_type(decision_tree(generic_test_tree(), i::FLOAT, 0.0::FLOAT, 0.0::FLOAT))
FROM range(4096) rows(i);
----
DICTIONARY_VECTOR

# The output threshold counts authored leaves, even when every value is equal.
statement ok
CREATE MACRO repeated_leaf_0(v) AS {value: v};

statement ok
CREATE MACRO repeated_leaf_1(v) AS {
    weights: [0], threshold: 0, below: repeated_leaf_0(v), above: repeated_leaf_0(v)
};

statement ok
CREATE MACRO repeated_leaf_2(v) AS {
    weights: [0], threshold: 0, below: repeated_leaf_1(v), above: repeated_leaf_1(v)
};

statement ok
CREATE MACRO repeated_leaf_3(v) AS {
    weights: [0], threshold: 0, below: repeated_leaf_2(v), above: repeated_leaf_2(v)
};

statement ok
CREATE MACRO repeated_leaf_4(v) AS {
    weights: [0], threshold: 0, below: repeated_leaf_3(v), above: repeated_leaf_3(v)
};

statement ok
CREATE MACRO repeated_leaf_5(v) AS {
    weights: [0], threshold: 0, below: repeated_leaf_4(v), above: repeated_leaf_4(v)
};

statement ok
CREATE MACRO repeated_leaf_6(v) AS {
    weights: [0], threshold: 0, below: repeated_leaf_5(v), above: repeated_leaf_5(v)
};

statement ok
CREATE MACRO repeated_leaf_7(v) AS {
    weights: [0], threshold: 0, below: repeated_leaf_6(v), above: repeated_leaf_6(v)
};

statement ok
CREATE MACRO repeated_leaf_8(v) AS {
    weights: [0], threshold: 0, below: repeated_leaf_7(v), above: repeated_leaf_7(v)
};

statement ok
CREATE MACRO repeated_leaf_9(v) AS {
    weights: [0], threshold: 0, below: repeated_leaf_8(v), above: repeated_leaf_8(v)
};

statement ok
CREATE MACRO repeated_leaf_10(v) AS {
    weights: [0], threshold: 0, below: repeated_leaf_9(v), above: repeated_leaf_9(v)
};

query T
SELECT DISTINCT vector_type(decision_tree(repeated_leaf_10(0), i::FLOAT))
FROM range(4096) rows(i);
----
FLAT_VECTOR

query I
SELECT count(*)
FROM test_vector_types(NULL::FLOAT, NULL::FLOAT, NULL::FLOAT) features(x0, x1, x2)
WHERE decision_tree(generic_test_tree(), x0, x1, x2)
      IS DISTINCT FROM decision_tree(generic_test_tree(), [x0, x1, x2]::FLOAT[3]);
----
0

query I
SELECT count(*)
FROM test_vector_types(NULL::FLOAT[3]) features(x)
WHERE decision_tree(generic_test_tree(), x)
      IS DISTINCT FROM decision_tree(generic_test_tree(), x[1], x[2], x[3]);
----
0

# Exercise the fixed-depth three-feature kernels for column and ARRAY inputs.
statement ok
CREATE MACRO fixed_depth_test_tree() AS {
    weights: [1, 0, 0],
    threshold: 0,
    below: {
        weights: [0, 1, 0],
        threshold: 0,
        below: {value: 10},
        above: {value: 20}
    },
    above: {
        weights: [0, 0, 1],
        threshold: 0,
        below: {value: 30},
        above: {value: 40}
    }
};

query I
SELECT count(*)
FROM test_vector_types(NULL::FLOAT, NULL::FLOAT, NULL::FLOAT) features(x0, x1, x2)
WHERE decision_tree(fixed_depth_test_tree(), x0, x1, x2)
      IS DISTINCT FROM CASE
          WHEN x0 IS NULL OR x1 IS NULL OR x2 IS NULL THEN NULL
          WHEN x0 >= 0 THEN CASE WHEN x2 >= 0 THEN 40 ELSE 30 END
          ELSE CASE WHEN x1 >= 0 THEN 20 ELSE 10 END
      END
   OR decision_tree(fixed_depth_test_tree(), [x0, x1, x2]::FLOAT[3])
      IS DISTINCT FROM decision_tree(fixed_depth_test_tree(), x0, x1, x2);
----
0

# Fixed kernels cover one through five features; larger feature counts use the generic kernel.
query TTTT
SELECT
    decision_tree(
        {
            weights: [1.0::DOUBLE, 1.0::DOUBLE, 1.0::DOUBLE, 1.0::DOUBLE],
            threshold: 10,
            below: {value: 'low'},
            above: {value: 'high'}
        },
        1.0::DOUBLE, 2.0::DOUBLE, 3.0::DOUBLE, 4.0::DOUBLE
    ),
    decision_tree(
        {
            weights: [1, 1, 1, 1, 1],
            threshold: 16,
            below: {value: 'low'},
            above: {value: 'high'}
        },
        [1, 2, 3, 4, 5]::FLOAT[5]
    ),
    decision_tree(
        {
            weights: [1, 1, 1, 1, 1, 1],
            threshold: 21,
            below: {value: 'low'},
            above: {value: 'high'}
        },
        1.0::FLOAT, 2.0::FLOAT, 3.0::FLOAT, 4.0::FLOAT, 5.0::FLOAT, 6.0::FLOAT
    ),
    decision_tree(
        {
            weights: [1, 1, 1, 1, 1, 1],
            threshold: 22,
            below: {value: 'low'},
            above: {value: 'high'}
        },
        [1, 2, 3, 4, 5, 6]::DOUBLE[6]
    );
----
high	low	high	low

# The generic kernel handles variable-depth topology for column and array inputs.
statement ok
CREATE MACRO generic_six_tree() AS {
    weights: [1, 0, 0, 0, 0, 0],
    threshold: 0,
    below: {value: 'left'},
    above: {
        weights: [0, 1, 0, 0, 0, 0],
        threshold: 0,
        below: {value: 'middle'},
        above: {value: 'right'}
    }
};

query I
SELECT count(*)
FROM (
    SELECT
        CASE i % 3 WHEN 0 THEN -1.0::FLOAT ELSE 1.0::FLOAT END AS x0,
        CASE i % 3 WHEN 1 THEN -1.0::FLOAT ELSE 1.0::FLOAT END AS x1,
        0.0::FLOAT AS x2,
        0.0::FLOAT AS x3,
        0.0::FLOAT AS x4,
        0.0::FLOAT AS x5,
        CASE i % 3 WHEN 0 THEN 'left' WHEN 1 THEN 'middle' ELSE 'right' END AS expected
    FROM range(10000) rows(i)
) features
WHERE decision_tree(generic_six_tree(), x0, x1, x2, x3, x4, x5) IS DISTINCT FROM expected
   OR decision_tree(generic_six_tree(), [x0, x1, x2, x3, x4, x5]::FLOAT[6]) IS DISTINCT FROM expected;
----
0

# Leaf values retain their complete logical type and are resolved after traversal.
query TII
SELECT result.label, result.payload[1], result.payload[2]
FROM (
    SELECT decision_tree(
        {
            weights: [1],
            threshold: 0,
            below: {value: {label: 'negative', payload: [10, 11]}},
            above: {value: {label: 'positive', payload: [20, 21]}}
        },
        x
    ) AS result
    FROM (VALUES (-1.0::DOUBLE), (1.0::DOUBLE)) features(x)
);
----
negative	10	11
positive	20	21

# NULL leaves and NULL features produce NULL outputs.
query I
SELECT decision_tree(
    {
        weights: [1],
        threshold: 0,
        below: {value: NULL},
        above: {value: 42}
    },
    x
) IS NULL
FROM (VALUES (-1.0::FLOAT), (1.0::FLOAT), (NULL::FLOAT)) features(x);
----
true
false
true

query T
SELECT typeof(decision_tree(
    {
        weights: [1],
        threshold: 0,
        below: {value: 10},
        above: {value: 20}
    },
    NULL::FLOAT
));
----
INTEGER

# Variable-depth trees are expressed directly rather than through node indices.
query I
SELECT decision_tree(
    {
        weights: [1],
        threshold: 0,
        below: {value: 10},
        above: {
            weights: [1],
            threshold: 10,
            below: {value: 20},
            above: {value: 30}
        }
    },
    x
)
FROM (VALUES (-1.0::FLOAT), (5.0::FLOAT), (10.0::FLOAT)) features(x);
----
10
20
30

# Equal-depth trees use implicit topology while preserving repeated leaf values.
query I
SELECT decision_tree(
    {
        weights: [1, 0],
        threshold: 0,
        below: {
            weights: [0, 1],
            threshold: 0,
            below: {value: 10},
            above: {value: 20}
        },
        above: {
            weights: [0, 1],
            threshold: 0,
            below: {value: 20},
            above: {value: 30}
        }
    },
    x,
    y
)
FROM (VALUES
    (-1.0::FLOAT, -1.0::FLOAT),
    (-1.0::FLOAT, 1.0::FLOAT),
    (1.0::FLOAT, -1.0::FLOAT),
    (1.0::FLOAT, 1.0::FLOAT)
) features(x, y);
----
10
20
20
30

# Different bound trees must not be merged by common-subexpression elimination.
query II
SELECT
    decision_tree(
        {
            weights: [1],
            threshold: 0,
            below: {value: 10},
            above: {value: 20}
        },
        x
    ),
    decision_tree(
        {
            weights: [1],
            threshold: 0,
            below: {value: 30},
            above: {value: 40}
        },
        x
    )
FROM (VALUES (-1.0::FLOAT), (1.0::FLOAT)) features(x);
----
10	30
20	40

# A tree can consist of one leaf and no internal nodes.
query I
SELECT decision_tree(
    {value: 42},
    123.0::FLOAT
);
----
42

# The tree must be constant and structurally valid.
statement error
SELECT decision_tree(tree_value, 1.0::FLOAT)
FROM (VALUES ({
    weights: [1],
    threshold: 0,
    below: {value: 0},
    above: {value: 1}
})) trees(tree_value);
----
<REGEX>:.+

statement error
SELECT decision_tree(
    {
        weights: [1, 2],
        threshold: 0,
        below: {value: 0},
        above: {value: 1}
    },
    1.0::FLOAT
);
----
<REGEX>:.+

statement error
SELECT decision_tree(
    {
        weights: [1],
        threshold: 0,
        below: {value: 0}
    },
    1.0::FLOAT
);
----
<REGEX>:.+

# FLOAT and DOUBLE parameters/features are promoted to DOUBLE when mixed.
query IT
SELECT decision_tree(
    {
        weights: [1.0::DOUBLE],
        threshold: 0,
        below: {value: 0::BIGINT},
        above: {value: 1::BIGINT}
    },
    1.0::FLOAT
), typeof(decision_tree(
    {
        weights: [1],
        threshold: 0.0::DOUBLE,
        below: {value: 'left'},
        above: {value: 'right'}
    },
    1.0::DOUBLE
));
----
1	VARCHAR

# Ordinary numeric literals in the tree are converted to the feature computation type.
query TT
SELECT decision_tree(
    {
        weights: [1],
        threshold: 0.5,
        below: {value: 0},
        above: {value: 1.5}
    },
    1.0::FLOAT
), typeof(decision_tree(
    {
        weights: [1],
        threshold: 0,
        below: {value: 0},
        above: {value: 1.5}
    },
    1.0::FLOAT
));
----
1.5	DECIMAL(11,1)

# Feature columns remain restricted to FLOAT and DOUBLE.
statement error
SELECT decision_tree(
    {
        weights: [1],
        threshold: 0,
        below: {value: 0},
        above: {value: 1}
    },
    1
);
----
<REGEX>:.+

# Node and leaf shapes are exact, and errors identify the authored path.
statement error
SELECT decision_tree(
    {
        weights: [1],
        threshold: 0,
        below: {value: 0, extra: 1},
        above: {value: 1}
    },
    1.0::FLOAT
);
----
<REGEX>:.*tree.below.*only.*value.*

statement error
SELECT decision_tree(
    {
        weights: [1],
        threshold: 0,
        below: {
            weights: [1, 2],
            threshold: 0,
            below: {value: 0},
            above: {value: 1}
        },
        above: {value: 2}
    },
    1.0::FLOAT
);
----
<REGEX>:.*tree.below.weights.*2 values.*1 features.*

# Untyped NULL leaves need another leaf to establish the common result type.
statement error
SELECT decision_tree({value: NULL}, 1.0::FLOAT);
----
<REGEX>:.*leaf values must have a concrete type.*
