# name: test/sql/dtree.test
# description: decision_tree scalar function
# group: [sql]

require dtree

# score = x0; negative values go to leaf 0. Non-negative values continue to
# score = x1, which selects leaf 1 below 10 and leaf 2 at or above 10.
query I
SELECT decision_tree(
    {
        coefficients: [[1.0::DOUBLE, 0.0::DOUBLE], [0.0::DOUBLE, 1.0::DOUBLE]],
        thresholds: [0.0::DOUBLE, 10.0::DOUBLE],
        left_children: [-1, -2],
        right_children: [1, -3],
        leaf_values: ['negative', 'small', 'large']
    },
    x,
    y
)
FROM (VALUES (-1.0::DOUBLE, 100.0::DOUBLE), (1.0::DOUBLE, 5.0::DOUBLE), (1.0::DOUBLE, 10.0::DOUBLE))
    features(x, y);
----
negative
small
large

# The fixed-size ARRAY overload uses the same baseline evaluator.
query I
SELECT decision_tree(
    {
        coefficients: [[1.0::FLOAT, 0.0::FLOAT], [0.0::FLOAT, 1.0::FLOAT]],
        thresholds: [0.0::FLOAT, 10.0::FLOAT],
        left_children: [-1, -2],
        right_children: [1, -3],
        leaf_values: [10, 20, 30]
    },
    [x, y]::FLOAT[2]
)
FROM (VALUES (-1.0::FLOAT, 100.0::FLOAT), (1.0::FLOAT, 5.0::FLOAT), (1.0::FLOAT, 10.0::FLOAT))
    features(x, y);
----
10
20
30

# The baseline loop handles different dimensionalities without specialized kernels.
query I
SELECT decision_tree(
    {
        coefficients: [[2.0::DOUBLE]],
        thresholds: [6.0::DOUBLE],
        left_children: [-1],
        right_children: [-2],
        leaf_values: ['left', 'right']
    },
    3.0::DOUBLE
);
----
right

query I
SELECT decision_tree(
    {
        coefficients: [[1.0::DOUBLE, 1.0::DOUBLE, 1.0::DOUBLE]],
        thresholds: [6.0::DOUBLE],
        left_children: [-1],
        right_children: [-2],
        leaf_values: [false, true]
    },
    1.0::DOUBLE, 2.0::DOUBLE, 3.0::DOUBLE
);
----
true

query I
SELECT decision_tree(
    {
        coefficients: [[1.0::FLOAT, 1.0::FLOAT, 1.0::FLOAT, 1.0::FLOAT]],
        thresholds: [11.0::FLOAT],
        left_children: [-1],
        right_children: [-2],
        leaf_values: [false, true]
    },
    1.0::FLOAT, 2.0::FLOAT, 3.0::FLOAT, 4.0::FLOAT
);
----
false

# Larger fixed arrays use the same runtime loop.
query I
SELECT decision_tree(
    {
        coefficients: [[1.0::DOUBLE, 1.0::DOUBLE, 1.0::DOUBLE, 1.0::DOUBLE, 1.0::DOUBLE]],
        thresholds: [15.0::DOUBLE],
        left_children: [-1],
        right_children: [-2],
        leaf_values: ['below', 'at-or-above']
    },
    [1, 2, 3, 4, 5]::DOUBLE[5]
);
----
at-or-above

# A mixture of FLOAT and DOUBLE computes as DOUBLE.
query I
SELECT decision_tree(
    {
        coefficients: [[1.5::FLOAT]],
        thresholds: [3.0::DOUBLE],
        left_children: [-1],
        right_children: [-2],
        leaf_values: ['below', 'above']
    },
    2.0::FLOAT
);
----
above

# The authored topology can use a nonzero root and arbitrary node order.
query I
SELECT decision_tree(
    {
        coefficients: [[1.0::DOUBLE], [1.0::DOUBLE]],
        thresholds: [10.0::DOUBLE, 0.0::DOUBLE],
        left_children: [-2, -1],
        right_children: [-3, 0],
        leaf_values: ['negative', 'small', 'large'],
        root: 1
    },
    x
)
FROM (VALUES (-1.0::DOUBLE), (5.0::DOUBLE), (10.0::DOUBLE)) features(x);
----
negative
small
large

# Exercise multiple vector chunks through the fixed-array evaluator.
query I
SELECT sum(decision_tree(
    {
        coefficients: [[1.0::DOUBLE, 0.0::DOUBLE, 0.0::DOUBLE, 0.0::DOUBLE, 0.0::DOUBLE]],
        thresholds: [5000.0::DOUBLE],
        left_children: [-1],
        right_children: [-2],
        leaf_values: [0, 1]
    },
    [i, i, i, i, i]::DOUBLE[5]
))
FROM range(10000) features(i);
----
5000

# Complex leaves retain their exact logical type and can be projected normally.
query II
SELECT
    result.label,
    result.payload[1]
FROM (
    SELECT decision_tree(
        {
            coefficients: [[1.0::DOUBLE]],
            thresholds: [0.0::DOUBLE],
            left_children: [-1],
            right_children: [-2],
            leaf_values: [
                {label: 'negative', payload: [10, 11]},
                {label: 'positive', payload: [20, 21]}
            ]
        },
        1.0::DOUBLE
    ) AS result
);
----
positive	20

# NULL features and NULL array elements produce NULL.
query I
SELECT decision_tree(
    {
        coefficients: [[1.0::DOUBLE]],
        thresholds: [0.0::DOUBLE],
        left_children: [-1],
        right_children: [-2],
        leaf_values: ['left', 'right']
    },
    NULL::DOUBLE
) IS NULL;
----
true

query I
SELECT decision_tree(
    {
        coefficients: [[1.0::FLOAT, 1.0::FLOAT]],
        thresholds: [0.0::FLOAT],
        left_children: [-1],
        right_children: [-2],
        leaf_values: ['left', 'right']
    },
    [1, NULL]::FLOAT[2]
) IS NULL;
----
true

# A tree can consist of one leaf and no internal nodes.
query I
SELECT decision_tree(
    {
        coefficients: []::DOUBLE[][],
        thresholds: []::DOUBLE[],
        left_children: []::INTEGER[],
        right_children: []::INTEGER[],
        leaf_values: [{answer: 42}],
        root: -1
    },
    123.0::DOUBLE
).answer;
----
42

# Tree definitions are compiled at bind time and therefore must be constant.
statement error
SELECT decision_tree(tree_value, 1.0::DOUBLE)
FROM (VALUES ({
    coefficients: [[1.0::DOUBLE]],
    thresholds: [0.0::DOUBLE],
    left_children: [-1],
    right_children: [-2],
    leaf_values: [0, 1]
})) trees(tree_value);
----
<REGEX>:.+

statement error
