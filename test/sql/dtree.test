    {
        coefficients: [[1.0::DOUBLE]],
        thresholds: [0.0::DOUBLE],
        left_children: [-1],
        right_children: [-2],
        leaf_values: [0, 1],
        root: 0.0
    },
    1.0::DOUBLE
);
----
<REGEX>:.+

