# name: test/sql/dtree.test
# description: decision_tree scalar function
# group: [sql]

require dtree

# score = x0; negative values select leaf 0. Non-negative values continue to
# score = x1, which selects leaf 1 below 10 and leaf 2 at or above 10.
query I
SELECT decision_tree(
    {
        coefficients: [[1.0::FLOAT, 0.0::FLOAT], [0.0::FLOAT, 1.0::FLOAT]],
        thresholds: [0.0::FLOAT, 10.0::FLOAT],
        left_children: [-1, -2],
        right_children: [1, -3],
        leaf_values: [10, 20, 30]
    },
    x,
    y
)
FROM (VALUES (-1.0::FLOAT, 100.0::FLOAT), (1.0::FLOAT, 5.0::FLOAT), (1.0::FLOAT, 10.0::FLOAT))
    features(x, y);
----
10
20
30

query I
SELECT decision_tree(
    {
        coefficients: [[1.0::FLOAT, 0.0::FLOAT], [0.0::FLOAT, 1.0::FLOAT]],
        thresholds: [0.0::FLOAT, 10.0::FLOAT],
        left_children: [-1, -2],
        right_children: [1, -3],
        leaf_values: [10, 20, 30]
    },
    [x, y]::FLOAT[2]
)
FROM (VALUES (-1.0::FLOAT, 100.0::FLOAT), (1.0::FLOAT, 5.0::FLOAT), (1.0::FLOAT, 10.0::FLOAT))
    features(x, y);
----
10
20
30

# Both overloads handle DuckDB's non-flat and nullable vector representations.
statement ok
CREATE MACRO generic_test_tree() AS {
    coefficients: [
        [1.0::FLOAT, 0.0::FLOAT, 0.0::FLOAT],
        [0.0::FLOAT, 1.0::FLOAT, 0.0::FLOAT]
    ],
    thresholds: [0.0::FLOAT, 0.0::FLOAT],
    left_children: [-1, -2],
    right_children: [1, -3],
    leaf_values: [10, 20, 30]
};

query T
SELECT DISTINCT vector_type(decision_tree(generic_test_tree(), i::FLOAT, 0.0::FLOAT, 0.0::FLOAT))
FROM range(4096) rows(i);
----
DICTIONARY_VECTOR

# The threshold counts authored leaves, even when their values are equal.
statement ok
CREATE MACRO dictionary_boundary_tree() AS {
    coefficients: list_transform(range(1023), lambda i: [0.0::FLOAT]),
    thresholds: list_transform(range(1023), lambda i: 0.0::FLOAT),
    left_children: list_transform(range(1023), lambda i:
        CASE WHEN 2 * i + 1 < 1023 THEN (2 * i + 1)::INTEGER ELSE (1022 - (2 * i + 1))::INTEGER END
    ),
    right_children: list_transform(range(1023), lambda i:
        CASE WHEN 2 * i + 2 < 1023 THEN (2 * i + 2)::INTEGER ELSE (1022 - (2 * i + 2))::INTEGER END
    ),
    leaf_values: list_transform(range(1024), lambda i: 0)
};

query T
SELECT DISTINCT vector_type(decision_tree(dictionary_boundary_tree(), i::FLOAT))
FROM range(4096) rows(i);
----
FLAT_VECTOR

query I
SELECT count(*)
FROM test_vector_types(NULL::FLOAT, NULL::FLOAT, NULL::FLOAT) features(x0, x1, x2)
WHERE decision_tree(generic_test_tree(), x0, x1, x2)
      IS DISTINCT FROM decision_tree(generic_test_tree(), [x0, x1, x2]::FLOAT[3]);
----
0

query I
SELECT count(*)
FROM test_vector_types(NULL::FLOAT[3]) features(x)
WHERE decision_tree(generic_test_tree(), x)
      IS DISTINCT FROM decision_tree(generic_test_tree(), x[1], x[2], x[3]);
----
0

# Exercise the fixed-depth three-feature kernels for column and ARRAY inputs.
statement ok
CREATE MACRO fixed_depth_test_tree() AS {
    coefficients: [
        [1.0::FLOAT, 0.0::FLOAT, 0.0::FLOAT],
        [0.0::FLOAT, 1.0::FLOAT, 0.0::FLOAT],
        [0.0::FLOAT, 0.0::FLOAT, 1.0::FLOAT]
    ],
    thresholds: [0.0::FLOAT, 0.0::FLOAT, 0.0::FLOAT],
    left_children: [1, -1, -3],
    right_children: [2, -2, -4],
    leaf_values: [10, 20, 30, 40]
};

query I
SELECT count(*)
FROM test_vector_types(NULL::FLOAT, NULL::FLOAT, NULL::FLOAT) features(x0, x1, x2)
WHERE decision_tree(fixed_depth_test_tree(), x0, x1, x2)
      IS DISTINCT FROM CASE
          WHEN x0 IS NULL OR x1 IS NULL OR x2 IS NULL THEN NULL
          WHEN x0 >= 0 THEN CASE WHEN x2 >= 0 THEN 40 ELSE 30 END
          ELSE CASE WHEN x1 >= 0 THEN 20 ELSE 10 END
      END
   OR decision_tree(fixed_depth_test_tree(), [x0, x1, x2]::FLOAT[3])
      IS DISTINCT FROM decision_tree(fixed_depth_test_tree(), x0, x1, x2);
----
0

# Fixed kernels cover one through five features; larger feature counts use the generic kernel.
query TTTT
SELECT
    decision_tree(
        {
            coefficients: [[1.0::DOUBLE, 1.0::DOUBLE, 1.0::DOUBLE, 1.0::DOUBLE]],
            thresholds: [10.0::DOUBLE],
            left_children: [-1],
            right_children: [-2],
            leaf_values: ['low', 'high']
        },
        1.0::DOUBLE, 2.0::DOUBLE, 3.0::DOUBLE, 4.0::DOUBLE
    ),
    decision_tree(
        {
            coefficients: [[1.0::FLOAT, 1.0::FLOAT, 1.0::FLOAT, 1.0::FLOAT, 1.0::FLOAT]],
            thresholds: [16.0::FLOAT],
            left_children: [-1],
            right_children: [-2],
            leaf_values: ['low', 'high']
        },
        [1, 2, 3, 4, 5]::FLOAT[5]
    ),
    decision_tree(
        {
            coefficients: [[1.0::FLOAT, 1.0::FLOAT, 1.0::FLOAT, 1.0::FLOAT, 1.0::FLOAT, 1.0::FLOAT]],
            thresholds: [21.0::FLOAT],
            left_children: [-1],
            right_children: [-2],
            leaf_values: ['low', 'high']
        },
        1.0::FLOAT, 2.0::FLOAT, 3.0::FLOAT, 4.0::FLOAT, 5.0::FLOAT, 6.0::FLOAT
    ),
    decision_tree(
        {
            coefficients: [[1.0::DOUBLE, 1.0::DOUBLE, 1.0::DOUBLE, 1.0::DOUBLE, 1.0::DOUBLE, 1.0::DOUBLE]],
            thresholds: [22.0::DOUBLE],
            left_children: [-1],
            right_children: [-2],
            leaf_values: ['low', 'high']
        },
        [1, 2, 3, 4, 5, 6]::DOUBLE[6]
    );
----
high	low	high	low

# The generic kernel handles variable-depth topology for column and array inputs.
statement ok
CREATE MACRO generic_six_tree() AS {
    coefficients: [
        [1.0::FLOAT, 0.0::FLOAT, 0.0::FLOAT, 0.0::FLOAT, 0.0::FLOAT, 0.0::FLOAT],
        [0.0::FLOAT, 1.0::FLOAT, 0.0::FLOAT, 0.0::FLOAT, 0.0::FLOAT, 0.0::FLOAT]
    ],
    thresholds: [0.0::FLOAT, 0.0::FLOAT],
    left_children: [-1, -2],
    right_children: [1, -3],
    leaf_values: ['left', 'middle', 'right']
};

query I
SELECT count(*)
FROM (
    SELECT
        CASE i % 3 WHEN 0 THEN -1.0::FLOAT ELSE 1.0::FLOAT END AS x0,
        CASE i % 3 WHEN 1 THEN -1.0::FLOAT ELSE 1.0::FLOAT END AS x1,
        0.0::FLOAT AS x2,
        0.0::FLOAT AS x3,
        0.0::FLOAT AS x4,
        0.0::FLOAT AS x5,
        CASE i % 3 WHEN 0 THEN 'left' WHEN 1 THEN 'middle' ELSE 'right' END AS expected
    FROM range(10000) rows(i)
) features
WHERE decision_tree(generic_six_tree(), x0, x1, x2, x3, x4, x5) IS DISTINCT FROM expected
   OR decision_tree(generic_six_tree(), [x0, x1, x2, x3, x4, x5]::FLOAT[6]) IS DISTINCT FROM expected;
----
0

# Leaf values retain their complete logical type and are resolved after traversal.
query TII
SELECT result.label, result.payload[1], result.payload[2]
FROM (
    SELECT decision_tree(
        {
            coefficients: [[1.0::DOUBLE]],
            thresholds: [0.0::DOUBLE],
            left_children: [-1],
            right_children: [-2],
            leaf_values: [
                {label: 'negative', payload: [10, 11]},
                {label: 'positive', payload: [20, 21]}
            ]
        },
        x
    ) AS result
    FROM (VALUES (-1.0::DOUBLE), (1.0::DOUBLE)) features(x)
);
----
negative	10	11
positive	20	21

# NULL leaves and NULL features produce NULL outputs.
query I
SELECT decision_tree(
    {
        coefficients: [[1.0::FLOAT]],
        thresholds: [0.0::FLOAT],
        left_children: [-1],
        right_children: [-2],
        leaf_values: [NULL::INTEGER, 42]
    },
    x
) IS NULL
FROM (VALUES (-1.0::FLOAT), (1.0::FLOAT), (NULL::FLOAT)) features(x);
----
true
false
true

query T
SELECT typeof(decision_tree(
    {
        coefficients: [[1.0::FLOAT]],
        thresholds: [0.0::FLOAT],
        left_children: [-1],
        right_children: [-2],
        leaf_values: [10, 20]
    },
    NULL::FLOAT
));
----
INTEGER

# The authored topology may use a nonzero root and arbitrary node order.
query I
SELECT decision_tree(
    {
        coefficients: [[1.0::FLOAT], [1.0::FLOAT]],
        thresholds: [10.0::FLOAT, 0.0::FLOAT],
        left_children: [-2, -1],
        right_children: [-3, 0],
        leaf_values: [10, 20, 30],
        root: 1
    },
    x
)
FROM (VALUES (-1.0::FLOAT), (5.0::FLOAT), (10.0::FLOAT)) features(x);
----
10
20
30

# Equal-depth trees use implicit topology while preserving authored leaf identities.
query I
SELECT decision_tree(
    {
        coefficients: [[0.0::FLOAT, 1.0::FLOAT], [0.0::FLOAT, 1.0::FLOAT], [1.0::FLOAT, 0.0::FLOAT]],
        thresholds: [0.0::FLOAT, 0.0::FLOAT, 0.0::FLOAT],
        left_children: [-1, -2, 0],
        right_children: [-2, -3, 1],
        leaf_values: [10, 20, 30],
        root: 2
    },
    x,
    y
)
FROM (VALUES
    (-1.0::FLOAT, -1.0::FLOAT),
    (-1.0::FLOAT, 1.0::FLOAT),
    (1.0::FLOAT, -1.0::FLOAT),
    (1.0::FLOAT, 1.0::FLOAT)
) features(x, y);
----
10
20
20
30

# Different bound trees must not be merged by common-subexpression elimination.
query II
SELECT
    decision_tree(
        {
            coefficients: [[1.0::FLOAT]],
            thresholds: [0.0::FLOAT],
            left_children: [-1],
            right_children: [-2],
            leaf_values: [10, 20]
        },
        x
    ),
    decision_tree(
        {
            coefficients: [[1.0::FLOAT]],
            thresholds: [0.0::FLOAT],
            left_children: [-1],
            right_children: [-2],
            leaf_values: [30, 40]
        },
        x
    )
FROM (VALUES (-1.0::FLOAT), (1.0::FLOAT)) features(x);
----
10	30
20	40

# A tree can consist of one leaf and no internal nodes.
query I
SELECT decision_tree(
    {
        coefficients: []::FLOAT[][],
        thresholds: []::FLOAT[],
        left_children: []::INTEGER[],
        right_children: []::INTEGER[],
        leaf_values: [42],
        root: -1
    },
    123.0::FLOAT
);
----
42

# The tree must be constant and structurally valid.
statement error
SELECT decision_tree(tree_value, 1.0::FLOAT)
FROM (VALUES ({
    coefficients: [[1.0::FLOAT]],
    thresholds: [0.0::FLOAT],
    left_children: [-1],
    right_children: [-2],
    leaf_values: [0, 1]
})) trees(tree_value);
----
<REGEX>:.+

statement error
SELECT decision_tree(
    {
        coefficients: [[1.0::FLOAT, 2.0::FLOAT]],
        thresholds: [0.0::FLOAT],
        left_children: [-1],
        right_children: [-2],
        leaf_values: [0, 1]
    },
    1.0::FLOAT
);
----
<REGEX>:.+

statement error
SELECT decision_tree(
    {
        coefficients: [[1.0::FLOAT]],
        thresholds: [0.0::FLOAT],
        left_children: [0],
        right_children: [-1],
        leaf_values: [0]
    },
    1.0::FLOAT
);
----
<REGEX>:.+

# FLOAT and DOUBLE parameters/features are promoted to DOUBLE when mixed.
query IT
SELECT decision_tree(
    {
        coefficients: [[1.0::DOUBLE]],
        thresholds: [0.0::FLOAT],
        left_children: [-1],
        right_children: [-2],
        leaf_values: [0::BIGINT, 1::BIGINT]
    },
    1.0::FLOAT
), typeof(decision_tree(
    {
        coefficients: [[1.0::FLOAT]],
        thresholds: [0.0::DOUBLE],
        left_children: [-1],
        right_children: [-2],
        leaf_values: ['left', 'right']
    },
    1.0::DOUBLE
));
----
1	VARCHAR

# Other numeric parameter and feature types are rejected.
statement error
SELECT decision_tree(
    {
        coefficients: [[1]],
        thresholds: [0.0::FLOAT],
        left_children: [-1],
        right_children: [-2],
        leaf_values: [0, 1]
    },
    1.0::FLOAT
);
----
