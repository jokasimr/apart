# Coefficients, thresholds, and features must be FLOAT or DOUBLE.
statement error
SELECT decision_tree(
    {
        coefficients: [[1]],
        thresholds: [0.0::DOUBLE],
        left_children: [-1],
        right_children: [-2],
        leaf_values: [0, 1]
    },
    1.0::DOUBLE
);
----
<REGEX>:.+

statement error
SELECT decision_tree(
    {
        coefficients: [[1.0::DOUBLE]],
        thresholds: [0.0::DOUBLE],
        left_children: [-1],
        right_children: [-2],
        leaf_values: [0, 1]
    },
    1
);
----
